# ===== 新闻聚合平台配置模板 =====
# 复制为 .env 后填写

# ---- 认证（单用户口令） ----
ADMIN_PASSWORD=changeme
AUTH_TOKEN_EXPIRE_HOURS=72

# ---- AI 模型 ----
# provider: deepseek | minimax | qwen ；留空则跳过 AI 解读
# AI_MODEL 示例：deepseek-chat / MiniMax-M3.1-Flash / qwen-plus
AI_PROVIDER=deepseek
AI_MODEL=
AI_MODEL_STRONG=
AI_API_KEY=
# 每批解读条数与单篇失败重试次数
INTERPRET_BATCH_SIZE=10
INTERPRET_RETRIES=2

# ---- 数据库（本地为 SQLite，上云可换 postgresql://...） ----
DATABASE_URL=sqlite:///data/news.db

# ---- 抓取 ----
FETCH_CONCURRENCY=4
FETCH_DELAY_SECONDS=1.5
TITLE_SIMILARITY_THRESHOLD=0.9
SIMHASH_DISTANCE_THRESHOLD=3

# ---- 定时 ----
# 每天触发的小时（逗号分隔，可多个时刻），未设置时用 CRON_HOUR
CRON_HOURS=12,21
CRON_MINUTE=0

# ---- 执行报告推送 ----
# 渠道：feishu | wecom | serverchan | pushplus | custom | off
# feishu / wecom / custom 填 NOTIFY_WEBHOOK；serverchan / pushplus 填 NOTIFY_TOKEN
# 飞书机器人开启「签名校验」时再填 NOTIFY_SECRET，未开启留空
NOTIFY_CHANNEL=off
NOTIFY_WEBHOOK=
NOTIFY_TOKEN=
NOTIFY_SECRET=
