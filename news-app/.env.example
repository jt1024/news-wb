# ===== 新闻聚合平台配置模板 =====
# 复制为 .env 后填写

# ---- 认证（单用户口令 + 独立签名密钥）----
# 口令用于登录；AUTH_SECRET 用于签发无状态 token，务必用随机串（不要用口令代替）
# 生成方式：python3 -c "import secrets; print(secrets.token_urlsafe(40))"
ADMIN_PASSWORD=changeme
AUTH_SECRET=
AUTH_TOKEN_EXPIRE_HOURS=72
# .env 权限建议 600：chmod 600 .env

# ---- AI 模型 ----
# provider: deepseek | minimax | qwen ；留空则跳过 AI 解读
# AI_MODEL 示例：deepseek-chat / MiniMax-M3.1-Flash / qwen-plus
AI_PROVIDER=deepseek
AI_MODEL=
AI_MODEL_STRONG=
AI_API_KEY=
# 每批解读条数与单篇失败重试次数
INTERPRET_BATCH_SIZE=10
INTERPRET_RETRIES=2

# ---- 数据库（本地为 SQLite，上云可换 postgresql://...） ----
DATABASE_URL=sqlite:///data/news.db

# ---- 抓取 ----
FETCH_CONCURRENCY=4
FETCH_DELAY_SECONDS=1.5
TITLE_SIMILARITY_THRESHOLD=0.9
SIMHASH_DISTANCE_THRESHOLD=3

# ---- 定时 ----
# 每天触发的小时（逗号分隔，可多个时刻），未设置时用 CRON_HOUR
CRON_HOURS=12,21
CRON_MINUTE=0

# ---- 执行报告推送 ----
# 渠道：feishu | wecom | serverchan | pushplus | custom | off
# feishu / wecom / custom 填 NOTIFY_WEBHOOK；serverchan / pushplus 填 NOTIFY_TOKEN
# 飞书机器人开启「签名校验」时再填 NOTIFY_SECRET，未开启留空
NOTIFY_CHANNEL=off
NOTIFY_WEBHOOK=
NOTIFY_TOKEN=
NOTIFY_SECRET=

# ---- 在线报告（可选）----
# 用活页发布 data/reports/latest.html 后，把固定链接与方案 ID 填这里；
# 飞书卡片会出现「查看完整报告」按钮，手机点开即可看全文
REPORT_PUBLIC_URL=
LIVEPAGE_PROPOSAL_ID=

# ---- AI 额度兜底（可选）----
# 主通道返回 402 时自动切换；留空则不启用，改走「告警 + 恢复后自动补解读」
# provider: deepseek | minimax | qwen
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# ---- WAF / 反爬 JS 挑战（可选）----
# 卫健委、药监局的 412 挑战需要本机 Chrome headless 预热通行 cookie；
# 不填则用 macOS 默认路径，找不到 Chrome 时这两个源本轮失败，不影响其它源。
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# 412 通行 cookie 缓存秒数（实测有效期约十几分钟）
WAF_COOKIE_TTL=600
# 留给挑战 JS 执行与自动重载的等待秒数 / 单次预热总超时
WAF_CHROME_WAIT=6
WAF_CHROME_TIMEOUT=40

# ---- 兜底守护（独立于 Web 服务，服务掉线也能告警/补跑）----
# 安装：在访达双击 scripts/run_watchdog_install.command
# loop 常驻模式的自检间隔秒数；launchd 模式固定每 1800 秒
WATCHDOG_INTERVAL=1800
# 12:00 / 21:00 轮次过后多久才判定为「漏跑」
WATCHDOG_GRACE_MIN=30
# 同类告警冷却小时数 / 同一轮次补跑的最小间隔分钟数
WATCHDOG_ALERT_COOLDOWN_HOURS=6
WATCHDOG_RETRY_MIN=60
# 置 0 则只告警，不自动拉起服务、不自动补跑或补发报告
WATCHDOG_AUTO_RECOVER=1
WATCHDOG_AUTO_RUN=1

# ---- 数据库热备 ----
# 每轮定时任务后生成当天快照，保留最近 N 天
BACKUP_KEEP_DAYS=14
# 可选：异地镜像目录绝对路径，留空则只做本地备份
BACKUP_MIRROR_DIR=
